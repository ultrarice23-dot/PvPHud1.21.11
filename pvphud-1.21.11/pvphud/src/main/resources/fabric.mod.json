{
  "schemaVersion": 1,
  "id": "pvphud",
  "version": "${version}",
  "name": "PvP HUD",
  "description": "Client-side PvP tracker: locked-target health, armor durability, combo, accuracy, popups and sounds. Fully themeable.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.pvphud.PvpHudClient"]
  },
  "mixins": ["pvphud.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
